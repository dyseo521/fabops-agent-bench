@@ -61,6 +61,18 @@ class BreakdownEvent:
         else:
             self.machine.pmed_time += length
         instance.handle_breakdown(self.machine, length)
+        # patched: expose the sampled downtime to plugins
+        self.last_length = length
+        self.machine_was_idle = False
+        # patched (opt-in): an idle tool that goes down stays unavailable until it is repaired.
+        # Upstream only delays work in progress, so an idle tool could still be dispatched to while down.
+        if getattr(instance, 'strict_downtime', False) and hasattr(instance, 'free_machines')                 and instance.free_machines[self.machine.idx]:
+            self.machine_was_idle = True
+            instance.free_machines[self.machine.idx] = False
+            instance.usable_machines.discard(self.machine)
+            ev = MachineDoneEvent(instance.current_time + length, [self.machine])
+            instance.add_event(ev)
+            self.machine.events.append(ev)
         for plugin in instance.plugins:
             if self.is_breakdown:
                 plugin.on_breakdown(instance, self)
